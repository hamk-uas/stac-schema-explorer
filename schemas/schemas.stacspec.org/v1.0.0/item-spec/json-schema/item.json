{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.stacspec.org/v1.0.0/item-spec/json-schema/item.json",
  "title": "STAC Item",
  "type": "object",
  "description": "This object represents the metadata for an item in a SpatioTemporal Asset Catalog.",
  "allOf": [
    {
      "$ref": "#/definitions/core"
    }
  ],
  "definitions": {
    "common_metadata": {
      "allOf": [
        {
          "$ref": "basics.json"
        },
        {
          "$ref": "datetime.json"
        },
        {
          "$ref": "instrument.json"
        },
        {
          "$ref": "licensing.json"
        },
        {
          "$ref": "provider.json"
        }
      ]
    },
    "core": {
      "allOf": [
        {
          "$ref": "https://geojson.org/schema/Feature.json"
        },
        {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "geometry",
                "bbox"
              ],
              "properties": {
                "geometry": {
                  "$ref": "https://geojson.org/schema/Geometry.json",
                  "title": "Geometry",
                  "description": "Defines the full footprint of the asset represented by this item, formatted according to RFC 7946, section 3.1. The footprint should be the default GeoJSON geometry, though additional geometries can be included. Coordinates are specified in Longitude/Latitude or Longitude/Latitude/Elevation based on WGS 84."
                },
                "bbox": {
                  "type": "array",
                  "oneOf": [
                    {
                      "minItems": 4,
                      "maxItems": 4
                    },
                    {
                      "minItems": 6,
                      "maxItems": 6
                    }
                  ],
                  "items": {
                    "type": "number"
                  },
                  "title": "Bounding Box",
                  "description": "REQUIRED if `geometry` is not `null`. Bounding Box of the asset represented by this Item, formatted according to RFC 7946, section 5."
                }
              }
            },
            {
              "type": "object",
              "required": [
                "geometry"
              ],
              "properties": {
                "geometry": {
                  "type": "null",
                  "title": "Geometry",
                  "description": "Defines the full footprint of the asset represented by this item, formatted according to RFC 7946, section 3.1. The footprint should be the default GeoJSON geometry, though additional geometries can be included. Coordinates are specified in Longitude/Latitude or Longitude/Latitude/Elevation based on WGS 84."
                },
                "bbox": {
                  "not": {}
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "required": [
            "stac_version",
            "id",
            "links",
            "assets",
            "properties"
          ],
          "properties": {
            "stac_version": {
              "title": "STAC version",
              "type": "string",
              "const": "1.0.0",
              "description": "The STAC version the Item implements."
            },
            "stac_extensions": {
              "title": "STAC extensions",
              "type": "array",
              "uniqueItems": true,
              "items": {
                "title": "Reference to a JSON Schema",
                "type": "string",
                "format": "iri"
              },
              "description": "A list of extensions the Item implements."
            },
            "type": {
              "title": "Type of GeoJSON Object",
              "description": "Type of the GeoJSON Object. MUST be set to `Feature`."
            },
            "id": {
              "title": "Provider ID",
              "description": "Provider item ID",
              "type": "string",
              "minLength": 1
            },
            "links": {
              "title": "Item links",
              "description": "Links to item relations",
              "type": "array",
              "items": {
                "$ref": "#/definitions/link"
              }
            },
            "assets": {
              "$ref": "#/definitions/assets"
            },
            "properties": {
              "allOf": [
                {
                  "$ref": "#/definitions/common_metadata"
                },
                {
                  "anyOf": [
                    {
                      "required": [
                        "datetime"
                      ],
                      "properties": {
                        "datetime": {
                          "not": {
                            "type": "null"
                          }
                        }
                      }
                    },
                    {
                      "required": [
                        "datetime",
                        "start_datetime",
                        "end_datetime"
                      ]
                    }
                  ]
                }
              ],
              "title": "Properties",
              "description": "A dictionary of additional metadata for the Item."
            }
          },
          "if": {
            "properties": {
              "links": {
                "contains": {
                  "required": [
                    "rel"
                  ],
                  "properties": {
                    "rel": {
                      "const": "collection"
                    }
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "collection"
            ],
            "properties": {
              "collection": {
                "title": "Collection ID",
                "description": "The ID of the STAC Collection this Item references to.",
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "collection": {
                "not": {}
              }
            }
          }
        }
      ]
    },
    "link": {
      "type": "object",
      "required": [
        "rel",
        "href"
      ],
      "properties": {
        "href": {
          "title": "Link reference",
          "type": "string",
          "format": "iri-reference",
          "minLength": 1,
          "description": "The actual link in the format of an URL. Relative and absolute links are both allowed."
        },
        "rel": {
          "title": "Link relation type",
          "type": "string",
          "minLength": 1,
          "description": "Relationship between the current document and the linked document."
        },
        "type": {
          "title": "Link type",
          "type": "string",
          "description": "Media type of the referenced entity."
        },
        "title": {
          "title": "Link title",
          "type": "string",
          "description": "A human readable title to be used in rendered displays of the link."
        }
      }
    },
    "assets": {
      "title": "Asset links",
      "description": "Links to assets",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/asset"
      }
    },
    "asset": {
      "allOf": [
        {
          "type": "object",
          "required": [
            "href"
          ],
          "properties": {
            "href": {
              "title": "Asset reference",
              "type": "string",
              "format": "iri-reference",
              "minLength": 1,
              "description": "URI to the asset object. Relative and absolute URI are both allowed."
            },
            "title": {
              "title": "Asset title",
              "type": "string",
              "description": "The displayed title for clients and users."
            },
            "description": {
              "title": "Asset description",
              "type": "string",
              "description": "A description of the Asset providing additional details, such as how it was processed or created. CommonMark 0.29 syntax MAY be used for rich text representation."
            },
            "type": {
              "title": "Asset type",
              "type": "string",
              "description": "Media type of the asset. See the common media types in the best practice doc for commonly used asset types."
            },
            "roles": {
              "title": "Asset roles",
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The semantic roles of the asset, similar to the use of `rel` in links."
            }
          }
        },
        {
          "$ref": "#/definitions/common_metadata"
        }
      ]
    }
  }
}
