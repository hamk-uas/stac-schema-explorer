{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stac-extensions.github.io/contacts/v0.1.1/schema.json",
  "title": "Contacts Extension",
  "description": "STAC Contacts Extension for STAC Catalogs, Collections and Items.",
  "type": "object",
  "required": [
    "stac_extensions"
  ],
  "properties": {
    "stac_extensions": {
      "type": "array",
      "contains": {
        "const": "https://stac-extensions.github.io/contacts/v0.1.1/schema.json"
      }
    }
  },
  "oneOf": [
    {
      "$comment": "This is the schema for STAC Items.",
      "type": "object",
      "required": [
        "type",
        "properties"
      ],
      "properties": {
        "type": {
          "const": "Feature"
        },
        "properties": {
          "$ref": "#/definitions/fields"
        }
      }
    },
    {
      "$comment": "This is the schema for STAC Catalogs.",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "Catalog"
        }
      },
      "allOf": [
        {
          "$ref": "#/definitions/fields"
        }
      ]
    },
    {
      "$comment": "This is the schema for STAC Collections.",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "Collection"
        }
      },
      "anyOf": [
        {
          "$ref": "#/definitions/fields"
        },
        {
          "$comment": "This is the schema for the fields in Summaries. By default, only checks the existance of the properties, but not the schema of the summaries.",
          "required": [
            "summaries"
          ],
          "properties": {
            "summaries": {
              "required": [
                "contacts"
              ]
            }
          }
        }
      ]
    }
  ],
  "definitions": {
    "fields": {
      "type": "object",
      "required": [
        "contacts"
      ],
      "properties": {
        "contacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "identifier": {
                "type": "string",
                "title": "Identifier",
                "description": "A value uniquely identifying a contact (individual or organization)."
              },
              "name": {
                "type": "string",
                "title": "Name",
                "description": "The name of the organization or the individual."
              },
              "positionName": {
                "type": "string",
                "title": "Position Name",
                "description": "The name of the role or position of the responsible person taken from the organization's formal organizational hierarchy or chart."
              },
              "organization": {
                "type": "string",
                "title": "Organization",
                "description": "Organization/affiliation of the individual/responsible person. In case of an organization, the name property should be used and this property is not to be used."
              },
              "logo": {
                "allOf": [
                  {
                    "$ref": "#/definitions/link"
                  },
                  {
                    "type": "object",
                    "required": [
                      "rel",
                      "type"
                    ],
                    "properties": {
                      "rel": {
                        "const": "icon"
                      }
                    }
                  }
                ],
                "title": "Logo",
                "description": "Graphic identifying a contact. The link relation must be `icon` and the media type must be an image media type."
              },
              "phones": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "value"
                  ],
                  "properties": {
                    "value": {
                      "type": "string",
                      "pattern": "^\\+[1-9]{1}[0-9]{3,14}$",
                      "title": "Value",
                      "description": "The actual contact information, depending on the context for example the actual phone number or the email address."
                    },
                    "roles": {
                      "$ref": "#/definitions/roles"
                    }
                  }
                },
                "title": "Phone",
                "description": "Telephone numbers at which contact can be made."
              },
              "emails": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "value"
                  ],
                  "properties": {
                    "value": {
                      "type": "string",
                      "format": "email",
                      "title": "Value",
                      "description": "The actual contact information, depending on the context for example the actual phone number or the email address."
                    },
                    "roles": {
                      "$ref": "#/definitions/roles"
                    }
                  }
                },
                "title": "Email",
                "description": "Email address at which contact can be made."
              },
              "addresses": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "deliveryPoint": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "title": "Delivery Point",
                      "description": "Address lines for the location, for example a street name and a house number."
                    },
                    "city": {
                      "type": "string",
                      "title": "City",
                      "description": "City for the location."
                    },
                    "administrativeArea": {
                      "type": "string",
                      "title": "Administrative Area",
                      "description": "State or province of the location."
                    },
                    "postalCode": {
                      "type": "string",
                      "title": "Postal Code",
                      "description": "ZIP or other postal code."
                    },
                    "country": {
                      "type": "string",
                      "title": "Country",
                      "description": "Country of the physical address."
                    },
                    "roles": {
                      "$ref": "#/definitions/roles"
                    }
                  }
                },
                "title": "Postal Addresses",
                "description": "Physical location at which contact can be made."
              },
              "links": {
                "type": "array",
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/definitions/link"
                    },
                    {
                      "type": "object",
                      "required": [
                        "type"
                      ]
                    }
                  ]
                }
              },
              "contactInstructions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "title": "Further Instructions",
                "description": "Supplemental instructions on how or when to contact the responsible party."
              },
              "roles": {
                "$ref": "#/definitions/roles"
              }
            }
          },
          "title": "Contacts",
          "description": "A list of contacts qualified by their role."
        }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "title": "Purpose",
      "description": "The set of named duties, job functions and/or permissions associated with this contact. See the Provider Object for examples."
    },
    "link": {
      "type": "object",
      "required": [
        "rel",
        "href"
      ],
      "properties": {
        "href": {
          "type": "string",
          "format": "iri-reference",
          "minLength": 1,
          "title": "Link reference",
          "description": "The actual link in the format of an URL. Relative and absolute links are both allowed."
        },
        "rel": {
          "type": "string",
          "minLength": 1,
          "title": "Link relation type",
          "description": "Relationship between the current document and the linked document."
        },
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "title": "Title",
          "description": "A human readable title to be used in rendered displays of the link."
        }
      }
    }
  }
}
