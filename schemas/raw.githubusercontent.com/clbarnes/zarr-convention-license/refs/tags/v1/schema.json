{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "License Convention",
  "description": "Schema for License Zarr convention",
  "type": "object",
  "properties": {
    "zarr_format": {
      "type": "integer",
      "description": "Zarr format version",
      "title": "Zarr Format"
    },
    "node_type": {
      "type": "string",
      "oneOf": [
        {
          "const": "array",
          "title": "Array"
        },
        {
          "const": "group",
          "title": "Group"
        }
      ],
      "description": "Type of Zarr node",
      "title": "Node Type"
    },
    "attributes": {
      "type": "object",
      "description": "Zarr attributes containing convention metadata and properties",
      "properties": {
        "zarr_conventions": {
          "type": "array",
          "description": "Array of convention metadata objects",
          "contains": {
            "$ref": "#/$defs/conventionMetadata"
          },
          "title": "Zarr Conventions"
        },
        "license": {
          "$ref": "#/$defs/license"
        }
      },
      "required": [
        "zarr_conventions",
        "license"
      ],
      "title": "Attributes"
    }
  },
  "required": [
    "zarr_format",
    "node_type",
    "attributes"
  ],
  "additionalProperties": true,
  "$defs": {
    "conventionMetadata": {
      "type": "object",
      "description": "Convention metadata object for use in zarr_conventions array",
      "properties": {
        "schema_url": {
          "type": "string",
          "const": "https://raw.githubusercontent.com/clbarnes/zarr-convention-license/refs/tags/v1/schema.json",
          "description": "URL to the JSON Schema definition for this convention",
          "title": "Schema URL"
        },
        "spec_url": {
          "type": "string",
          "const": "https://github.com/clbarnes/zarr-convention-license/blob/v1/README.md",
          "description": "URL to the full specification document",
          "title": "Specification URL"
        },
        "uuid": {
          "type": "string",
          "const": "b77365e5-2b0c-4141-b917-c03b7c68e935",
          "description": "UUID that permanently identifies this convention",
          "title": "UUID"
        },
        "name": {
          "type": "string",
          "description": "Human-readable name of the convention. Should be 'license'",
          "title": "Name"
        },
        "description": {
          "type": "string",
          "const": "License specifier for Zarr data",
          "description": "Brief description of the convention's purpose and usage",
          "title": "Description"
        }
      },
      "anyOf": [
        {
          "required": [
            "schema_url"
          ]
        },
        {
          "required": [
            "spec_url"
          ]
        },
        {
          "required": [
            "uuid"
          ]
        }
      ],
      "additionalProperties": false
    },
    "license": {
      "type": "object",
      "description": "Licensing information for this data",
      "properties": {
        "spdx": {
          "type": "string",
          "description": "SPDX identifier of the license.",
          "title": "SPDX license expression"
        },
        "url": {
          "type": "string",
          "description": "URL to the full text of the license.",
          "title": "License URL"
        },
        "text": {
          "type": "string",
          "description": "Full text of the license.",
          "title": "License text"
        },
        "file": {
          "type": "string",
          "description": "Path to an object containing the full text of the license.",
          "title": "License file"
        },
        "path": {
          "type": "string",
          "description": "Path to a Zarr node with license metadata.",
          "title": "License node path"
        }
      },
      "anyOf": [
        {
          "required": [
            "spdx"
          ]
        },
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "text"
          ]
        },
        {
          "required": [
            "file"
          ]
        },
        {
          "required": [
            "path"
          ]
        }
      ],
      "title": "License"
    }
  }
}
