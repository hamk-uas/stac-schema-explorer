{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coordinate Set Convention",
  "description": "Schema for the coordinate set convention",
  "type": "object",
  "properties": {
    "zarr_format": {
      "type": "integer",
      "oneOf": [
        {
          "const": 2,
          "title": "2"
        },
        {
          "const": 3,
          "title": "3"
        }
      ],
      "description": "Zarr format version",
      "title": "Zarr Format"
    },
    "node_type": {
      "type": "string",
      "oneOf": [
        {
          "const": "array",
          "title": "Array"
        },
        {
          "const": "group",
          "title": "Group"
        }
      ],
      "description": "Type of Zarr node",
      "title": "Node Type"
    },
    "shape": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "title": "Shape",
      "description": "Extent of the Zarr array along each dimension."
    },
    "dimension_names": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
      },
      "title": "Dimension Names",
      "description": "Names of the Zarr array dimensions, referenced by coordinate set axes."
    },
    "attributes": {
      "type": "object",
      "description": "Zarr attributes containing convention metadata and properties",
      "properties": {
        "zarr_conventions": {
          "type": "array",
          "description": "Array of convention metadata objects",
          "contains": {
            "$ref": "#/$defs/conventionMetadata"
          },
          "title": "Zarr Conventions"
        }
      },
      "required": [
        "zarr_conventions"
      ],
      "title": "Attributes"
    }
  },
  "required": [
    "zarr_format",
    "node_type",
    "attributes"
  ],
  "if": {
    "properties": {
      "node_type": {
        "const": "array"
      }
    }
  },
  "then": {
    "required": [
      "shape",
      "dimension_names"
    ],
    "properties": {
      "attributes": {
        "type": "object",
        "required": [
          "cs"
        ],
        "properties": {
          "cs": {
            "$ref": "#/$defs/cs"
          }
        },
        "title": "Attributes",
        "description": "Attributes of the CS."
      }
    }
  },
  "else": {
    "properties": {
      "attributes": {
        "type": "object",
        "required": [
          "crs"
        ],
        "properties": {
          "crs": {
            "type": "object",
            "description": "Keyed CRS objects stored in a Zarr group, keyed by CRS name",
            "minProperties": 1,
            "additionalProperties": {
              "$ref": "#/$defs/crs"
            },
            "title": "CRS"
          }
        },
        "title": "Attributes",
        "description": "Attributes of the CS."
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "conventionMetadata": {
      "type": "object",
      "description": "Convention metadata object for use in zarr_conventions array",
      "properties": {
        "schema_url": {
          "type": "string",
          "const": "https://raw.githubusercontent.com/R-CF/zarr_conventions_cs/refs/heads/main/schema.json",
          "description": "URL to the JSON Schema definition for this convention",
          "title": "Schema Url"
        },
        "spec_url": {
          "type": "string",
          "const": "https://raw.githubusercontent.com/R-CF/zarr_convention_cs/refs/heads/main/README.md",
          "description": "URL to the full specification document",
          "title": "Spec Url"
        },
        "uuid": {
          "type": "string",
          "const": "e4dbf0b7-7a00-4ce6-b23e-484292014ab4",
          "description": "UUID that permanently identifies this convention",
          "title": "Uuid"
        },
        "name": {
          "type": "string",
          "description": "cs",
          "title": "Name"
        },
        "description": {
          "type": "string",
          "const": "Coordinate set convention for Zarr arrays",
          "description": "Convention to assign semantic meaning to the dimensions of Zarr arrays, using axes and coordinates",
          "title": "Description"
        }
      },
      "anyOf": [
        {
          "required": [
            "schema_url"
          ]
        },
        {
          "required": [
            "spec_url"
          ]
        },
        {
          "required": [
            "uuid"
          ]
        }
      ],
      "additionalProperties": false
    },
    "cs": {
      "type": "object",
      "description": "Coordinate set for n-dimensional arrays",
      "properties": {
        "name": {
          "type": "string",
          "description": "Descriptive name for the coordinate set.",
          "title": "Name"
        },
        "crs": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/crs"
              },
              {
                "$ref": "https://raw.githubusercontent.com/R-CF/zarr_convention_ref/refs/tags/v2.0.0/schema.json#/$defs/refProperty"
              }
            ]
          },
          "title": "CRS",
          "description": "Keyed `crs` objects."
        },
        "id": {
          "$ref": "https://raw.githubusercontent.com/zarr-conventions/proj/refs/tags/v0.1/schema.json#/$defs/projAttributes",
          "title": "Identifier"
        },
        "attributes": {
          "type": "object",
          "title": "Attributes",
          "description": "Attributes of the CS."
        }
      },
      "required": [
        "crs"
      ],
      "title": "Cs"
    },
    "crs": {
      "type": "object",
      "description": "CRS definition",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the CRS",
          "title": "Name"
        },
        "type": {
          "type": "string",
          "oneOf": [
            {
              "const": "compound",
              "title": "Compound"
            },
            {
              "const": "planar",
              "title": "Planar"
            },
            {
              "const": "vertical",
              "title": "Vertical"
            },
            {
              "const": "temporal",
              "title": "Temporal"
            },
            {
              "const": "undefined",
              "title": "Undefined"
            }
          ],
          "description": "Type of the CRS",
          "title": "Type"
        },
        "description": {
          "type": "string",
          "description": "Description of the nature of the CRS",
          "title": "Description"
        },
        "axes": {
          "type": "object",
          "description": "Keyed axis objects, keyed by dimension name",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/axis"
          },
          "title": "Axes"
        },
        "id": {
          "$ref": "https://raw.githubusercontent.com/zarr-conventions/proj/refs/tags/v0.1/schema.json#/$defs/projAttributes",
          "title": "Identifier"
        },
        "geolocation": {
          "$ref": "https://raw.githubusercontent.com/R-CF/zarr_convention_geolocation/refs/tags/v1.1.0/schema.json#/$defs/geolocation",
          "title": "Geolocation",
          "description": "Geolocation arrays."
        }
      },
      "required": [
        "type",
        "axes"
      ],
      "additionalProperties": true
    },
    "axis": {
      "type": "object",
      "description": "Properties of an individual axis.",
      "properties": {
        "abbreviation": {
          "type": "string",
          "description": "Abbreviation of the axis, such as \"X\" or \"Y\".",
          "title": "Abbreviation"
        },
        "coordinates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coordinates"
          },
          "title": "Coordinates",
          "description": "Array of coordinates for the axis."
        },
        "attributes": {
          "type": "object",
          "title": "Attributes",
          "description": "Any other attributes of the axis."
        }
      },
      "additionalProperties": true
    },
    "coordinates": {
      "type": "object",
      "description": "Properties of a set of coordinates",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the set of coordinates.",
          "title": "Name"
        },
        "direction": {
          "type": "string",
          "description": "The direction of increasing coordinate values. Its value must be taken from Table 48 of OGC standard \"Referencing by Coordinates\".",
          "title": "Direction"
        },
        "unit": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "https://raw.githubusercontent.com/clbarnes/zarr-convention-uom/refs/tags/v1/schema.json#/$defs/uom"
            }
          ],
          "title": "Unit of Values",
          "description": "Unit-of-measure of the coordinates."
        },
        "time": {
          "$ref": "#/$defs/time"
        },
        "values": {
          "$ref": "#/$defs/values"
        },
        "boundaries": {
          "$ref": "#/$defs/boundaries"
        },
        "parametric": {
          "$ref": "#/$defs/parametric"
        },
        "attributes": {
          "type": "object",
          "title": "Attributes",
          "description": "Any other attributes of the coordinates."
        }
      },
      "required": [
        "values"
      ],
      "additionalProperties": true
    },
    "time": {
      "type": "object",
      "description": "The time definition of a set of coordinates.",
      "properties": {
        "unit": {
          "type": "string",
          "title": "Unit of Values",
          "description": "Time unit."
        },
        "epoch": {
          "type": "string",
          "title": "Epoch",
          "description": "The epoch for the time calculations."
        },
        "calendar": {
          "type": "string",
          "title": "Calendar",
          "description": "Name of a calendar."
        }
      },
      "required": [
        "unit",
        "epoch"
      ],
      "additionalProperties": true,
      "title": "Time"
    },
    "values": {
      "type": "object",
      "description": "The coordinate values of an axis",
      "properties": {
        "regular": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Initial coordinate value (at shape index 0) and increment between successive coordinates.",
          "minItems": 2,
          "maxItems": 2,
          "title": "Regular"
        },
        "external": {
          "type": "object",
          "properties": {
            "ref": {
              "$ref": "https://raw.githubusercontent.com/R-CF/zarr_convention_ref/refs/tags/v2.0.0/schema.json#/$defs/ref"
            }
          },
          "required": [
            "ref"
          ],
          "description": "Reference to a 1-dimensional array with coordinate values.",
          "title": "External"
        },
        "explicit": {
          "type": "array",
          "description": "JSON array of coordinate values.",
          "title": "Explicit"
        }
      },
      "oneOf": [
        {
          "required": [
            "regular"
          ]
        },
        {
          "required": [
            "external"
          ]
        },
        {
          "required": [
            "explicit"
          ]
        }
      ],
      "additionalProperties": true,
      "title": "Values"
    },
    "boundaries": {
      "type": "object",
      "description": "The boundary values around coordinate values of an axis",
      "properties": {
        "regular": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "JSON array with the extent below and above the coordinate value.",
          "minItems": 2,
          "maxItems": 2,
          "title": "Regular"
        },
        "external": {
          "type": "object",
          "properties": {
            "ref": {
              "$ref": "https://raw.githubusercontent.com/R-CF/zarr_convention_ref/refs/tags/v2.0.0/schema.json#/$defs/ref"
            }
          },
          "required": [
            "ref"
          ],
          "description": "Path to an array providing boundary values.",
          "title": "External"
        },
        "attributes": {
          "type": "object",
          "title": "Attributes",
          "description": "Any other attributes of the boundaries object."
        }
      },
      "oneOf": [
        {
          "required": [
            "regular"
          ]
        },
        {
          "required": [
            "external"
          ]
        }
      ],
      "additionalProperties": true,
      "title": "Boundaries"
    },
    "parametric": {
      "type": "object",
      "description": "Formula and terms for parametric coordinates",
      "properties": {
        "formula": {
          "type": "string",
          "title": "Formula",
          "description": "The name of the formulation, the `\"standard_name\"` used in CF."
        },
        "terms": {
          "type": "object",
          "description": "Keyed values objects, keyed by name of the formula term",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/values"
          },
          "title": "Terms"
        }
      },
      "required": [
        "formula",
        "terms"
      ],
      "title": "Parametric"
    }
  }
}
