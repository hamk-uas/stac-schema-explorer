{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/R-CF/zarr_convention_geolocation/refs/tags/v2.0.0/schema.json",
  "title": "Geolocation Convention",
  "description": "Schema for the geolocation Zarr convention",
  "type": "object",
  "properties": {
    "zarr_format": {
      "type": "integer",
      "description": "Zarr format version",
      "title": "Zarr Format"
    },
    "node_type": {
      "type": "string",
      "oneOf": [
        {
          "const": "array",
          "title": "Array"
        },
        {
          "const": "group",
          "title": "Group"
        }
      ],
      "description": "Type of Zarr node",
      "title": "Node Type"
    },
    "attributes": {
      "type": "object",
      "description": "Zarr attributes containing convention metadata and properties",
      "properties": {
        "zarr_conventions": {
          "type": "array",
          "description": "Array of convention metadata objects",
          "contains": {
            "$ref": "#/$defs/conventionMetadata"
          },
          "title": "Zarr Conventions"
        },
        "geolocation": {
          "$ref": "#/$defs/geolocation"
        }
      },
      "required": [
        "zarr_conventions"
      ],
      "title": "Attributes"
    }
  },
  "required": [
    "zarr_format",
    "node_type",
    "attributes"
  ],
  "additionalProperties": true,
  "$defs": {
    "conventionMetadata": {
      "type": "object",
      "description": "Geolocation convention metadata object for use in zarr_conventions array",
      "properties": {
        "schema_url": {
          "type": "string",
          "pattern": "^https://raw\\.githubusercontent\\.com/R-CF/zarr_convention_geolocation/refs/tags/v2\\.[0-9]+\\.[0-9]+/schema\\.json$",
          "description": "URL to the JSON Schema definition for this convention",
          "title": "Schema Url"
        },
        "spec_url": {
          "type": "string",
          "pattern": "^https://github\\.com/R-CF/zarr_convention_geolocation/blob/v2\\.[0-9]+\\.[0-9]+/README\\.md$",
          "description": "URL to the full specification document",
          "title": "Spec Url"
        },
        "uuid": {
          "type": "string",
          "const": "bb9ee930-8c60-4c47-ad6b-8daa558987ed",
          "description": "UUID that permanently identifies this convention",
          "title": "Uuid"
        },
        "name": {
          "type": "string",
          "description": "Geolocation arrays for Zarr arrays",
          "title": "Name"
        },
        "description": {
          "type": "string",
          "const": "Convention for storing geolocation arrays",
          "description": "This convention provides a standard way to store geolocation arrays",
          "title": "Description"
        }
      },
      "anyOf": [
        {
          "required": [
            "schema_url"
          ]
        },
        {
          "required": [
            "spec_url"
          ]
        },
        {
          "required": [
            "uuid"
          ]
        }
      ],
      "additionalProperties": false
    },
    "geolocation": {
      "type": "object",
      "properties": {
        "geodetic": {
          "$ref": "#/$defs/arrays",
          "title": "Geodetic",
          "description": "Object for geodetic geolocation."
        },
        "planar": {
          "$ref": "#/$defs/arrays",
          "title": "Planar",
          "description": "Object for planar geolocation."
        }
      },
      "anyOf": [
        {
          "required": [
            "geodetic"
          ]
        },
        {
          "required": [
            "planar"
          ]
        }
      ],
      "additionalProperties": false,
      "title": "Geolocation",
      "description": "The geolocation object."
    },
    "arrays": {
      "type": "object",
      "properties": {
        "x": {
          "$ref": "#/$defs/coordinate",
          "title": "X"
        },
        "y": {
          "$ref": "#/$defs/coordinate",
          "title": "Y"
        },
        "id": {
          "$ref": "https://raw.githubusercontent.com/zarr-conventions/proj/refs/tags/v0.1/schema.json#/$defs/projAttributes",
          "title": "Identifier"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "description": "Boundaries for both x and y",
          "properties": {
            "x": {
              "required": [
                "boundaries"
              ]
            },
            "y": {
              "required": [
                "boundaries"
              ]
            }
          }
        },
        {
          "description": "Boundaries for neither x nor y",
          "properties": {
            "x": {
              "not": {
                "required": [
                  "boundaries"
                ]
              }
            },
            "y": {
              "not": {
                "required": [
                  "boundaries"
                ]
              }
            }
          }
        }
      ]
    },
    "coordinate": {
      "type": "object",
      "description": "The geolocation array and optional boundary array of the x or y coordinates",
      "properties": {
        "values": {
          "$ref": "https://raw.githubusercontent.com/R-CF/zarr_convention_ref/refs/tags/v2.0.0/schema.json#/$defs/refProperty",
          "description": "Reference to the geolocation array"
        },
        "boundaries": {
          "$ref": "https://raw.githubusercontent.com/R-CF/zarr_convention_ref/refs/tags/v2.0.0/schema.json#/$defs/refProperty",
          "description": "Reference to the array with the cell vertices"
        }
      },
      "required": [
        "values"
      ],
      "additionalProperties": false
    }
  }
}
