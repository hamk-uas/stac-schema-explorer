{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NZ-1.0 Convention",
  "description": "Schema for NZ (NetCDF Zarr convention) — structural interoperability layer for scientific array conventions on Zarr v3",
  "type": "object",
  "properties": {
    "zarr_format": {
      "type": "integer",
      "const": 3,
      "description": "Zarr format version",
      "title": "Zarr format"
    },
    "node_type": {
      "type": "string",
      "oneOf": [
        {
          "const": "array",
          "title": "Array",
          "description": "A Zarr array node: an N-dimensional array of one data type, with dimension names."
        },
        {
          "const": "group",
          "title": "Group",
          "description": "A Zarr group node: a container of arrays and other groups."
        }
      ],
      "description": "Type of Zarr node",
      "title": "Node type"
    },
    "attributes": {
      "type": "object",
      "description": "Zarr attributes containing convention metadata and properties",
      "properties": {
        "zarr_conventions": {
          "type": "array",
          "description": "Array of convention metadata objects",
          "contains": {
            "$ref": "#/$defs/conventionMetadata"
          },
          "title": "Declared conventions"
        }
      },
      "required": [
        "zarr_conventions"
      ],
      "title": "Attributes"
    }
  },
  "required": [
    "zarr_format",
    "node_type",
    "attributes"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "node_type": {
            "const": "group"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/groupRequirements"
      }
    },
    {
      "if": {
        "properties": {
          "node_type": {
            "const": "array"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/arrayRequirements"
      }
    }
  ],
  "$defs": {
    "conventionMetadata": {
      "type": "object",
      "description": "NZ convention metadata object for use in zarr_conventions array",
      "properties": {
        "schema_url": {
          "type": "string",
          "const": "https://raw.githubusercontent.com/zarr-conventions/nz/refs/tags/v1/schema.json",
          "description": "URL to the JSON Schema definition for this convention",
          "title": "Schema URL"
        },
        "spec_url": {
          "type": "string",
          "const": "https://github.com/zarr-conventions/nz/blob/v1/README.md",
          "description": "URL to the full specification document",
          "title": "Specification URL"
        },
        "uuid": {
          "type": "string",
          "const": "d0a980b5-c644-4dcc-85a1-283799a58f40",
          "description": "UUID that permanently identifies this convention",
          "title": "Convention UUID"
        },
        "name": {
          "type": "string",
          "const": "NZ-1.0",
          "description": "Human-readable name of the convention",
          "title": "Convention name"
        },
        "description": {
          "type": "string",
          "description": "Brief description of the convention's purpose",
          "title": "Convention description"
        }
      },
      "anyOf": [
        {
          "required": [
            "schema_url"
          ]
        },
        {
          "required": [
            "spec_url"
          ]
        },
        {
          "required": [
            "uuid"
          ]
        }
      ],
      "additionalProperties": false
    },
    "zarrDataType": {
      "type": "string",
      "description": "Zarr v3 data type name",
      "oneOf": [
        {
          "const": "bool",
          "title": "Boolean"
        },
        {
          "const": "int8",
          "title": "8-bit signed integer"
        },
        {
          "const": "uint8",
          "title": "8-bit unsigned integer"
        },
        {
          "const": "int16",
          "title": "16-bit signed integer"
        },
        {
          "const": "uint16",
          "title": "16-bit unsigned integer"
        },
        {
          "const": "int32",
          "title": "32-bit signed integer"
        },
        {
          "const": "uint32",
          "title": "32-bit unsigned integer"
        },
        {
          "const": "int64",
          "title": "64-bit signed integer"
        },
        {
          "const": "uint64",
          "title": "64-bit unsigned integer"
        },
        {
          "const": "float32",
          "title": "32-bit floating point"
        },
        {
          "const": "float64",
          "title": "64-bit floating point"
        },
        {
          "const": "complex64",
          "title": "64-bit complex (two 32-bit floats)"
        },
        {
          "const": "complex128",
          "title": "128-bit complex (two 64-bit floats)"
        }
      ],
      "title": "Zarr data type"
    },
    "nczarrAttr": {
      "type": "object",
      "description": "The _nczarr_attr attribute: attribute type annotations using Zarr v3 data type names",
      "properties": {
        "types": {
          "type": "object",
          "description": "Maps attribute names to Zarr v3 data type names",
          "additionalProperties": {
            "$ref": "#/$defs/zarrDataType"
          },
          "title": "Attribute types"
        }
      },
      "required": [
        "types"
      ],
      "additionalProperties": false,
      "title": "Attribute types (_nczarr_attr)"
    },
    "groupRequirements": {
      "type": "object",
      "description": "Requirements specific to group nodes in NZ",
      "properties": {
        "attributes": {
          "type": "object",
          "properties": {
            "conventions": {
              "type": "string",
              "pattern": "NZ-1\\.0",
              "description": "Space-separated convention identifiers; MUST include NZ-1.0",
              "title": "Conventions"
            },
            "_nczarr_attr": {
              "$ref": "#/$defs/nczarrAttr"
            }
          },
          "required": [
            "conventions"
          ],
          "title": "Group attributes",
          "description": "Attributes NZ defines for a group: the root group declares NZ-1.0 in conventions."
        }
      },
      "title": "Group requirements"
    },
    "arrayRequirements": {
      "type": "object",
      "description": "Requirements specific to array nodes in NZ",
      "properties": {
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Array shape",
          "title": "Shape"
        },
        "dimension_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Dimension labels; MUST have same length as shape; no null or empty entries",
          "title": "Dimension names"
        },
        "data_type": {
          "type": "string",
          "description": "Array data type",
          "title": "Data type"
        },
        "attributes": {
          "type": "object",
          "properties": {
            "_FillValue": {
              "description": "Semantic missing data indicator",
              "title": "Fill value (missing data)"
            },
            "_nczarr_attr": {
              "$ref": "#/$defs/nczarrAttr"
            }
          },
          "additionalProperties": true,
          "title": "Array attributes",
          "description": "Attributes NZ reserves for an array: its semantic missing-data indicator."
        }
      },
      "required": [
        "dimension_names",
        "shape"
      ],
      "title": "Array requirements"
    }
  }
}
