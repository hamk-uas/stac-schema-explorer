{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hamk-uas.github.io/stac-schema-explorer/schemas/unc/v0.1/schema.json",
  "title": "UNC v0.1 uncertainty attributes",
  "description": "Unofficial JSON Schema of the Uncertainty Metadata Naming Conventions (UNC) v0.1 (https://comet-toolkit.github.io/unc_website/specification/v0.1/unc_specification.html), as written and read by obsarray: an observation variable lists its uncertainty variables in unc_comps; each uncertainty variable has a PDF shape and per dimension, or set of dimensions, an error-correlation parameterisation. An uncertainty variable without units is a fractional uncertainty, and obsarray reads units of % as percent. The numbered error-correlation attributes are err_corr_<i>_dim, _form, _params and _units (parameterisations 1 to 9), the spelling obsarray and the software built on it (punpy, the HYPERNETS processor) write and read. The specification names them err_corr_dim<i>_name, _form, _params and _units, which no known software reads, so they are not fields of this schema. Superseded by the incompatible draft v0.2. Rules spanning variables (named variables exist, equal dimensions) are not checked.",
  "type": "object",
  "definitions": {
    "dims": {
      "description": "The dimension, or list of dimensions, of the observation variable this error-correlation parameterisation applies to.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      ],
      "examples": [
        "time"
      ]
    },
    "form": {
      "description": "The error-correlation form along these dimensions. Forms beyond the standard ones may be defined.",
      "anyOf": [
        {
          "oneOf": [
            {
              "const": "random",
              "title": "Random",
              "description": "No error correlation between elements: an identity matrix."
            },
            {
              "const": "systematic",
              "title": "Systematic",
              "description": "Full error correlation between elements: a matrix of ones."
            },
            {
              "const": "err_corr_matrix",
              "title": "Error-correlation matrix",
              "description": "An explicit error-correlation matrix, in the variable the parameters name."
            },
            {
              "const": "ensemble",
              "title": "Ensemble",
              "description": "Registered by obsarray, which cannot build its matrix yet."
            }
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "params": {
      "description": "Parameters of the form, such as the name of the error-correlation matrix variable for err_corr_matrix; empty or absent when the form takes none. A single parameter may be stored as a scalar.",
      "anyOf": [
        {
          "type": [
            "string",
            "number"
          ]
        },
        {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      ],
      "examples": [
        []
      ]
    },
    "units": {
      "description": "Units of the parameters, in their order; empty or absent when there are none.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      ],
      "examples": [
        []
      ]
    }
  },
