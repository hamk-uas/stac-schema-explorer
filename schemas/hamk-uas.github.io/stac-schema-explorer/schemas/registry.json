      "specification": "https://github.com/zarr-conventions/nz",
      "maturity": "Proposal",
      "checked": {
        "date": "2026-11-03",
        "latest": "v1-draft",
        "source": "https://github.com/zarr-conventions/nz",
        "note": "NZ-1.0 has no release yet: the v1 tag its README and schema name is not published, and the only tag, v1-proposed, is an earlier draft named NZUG-1.0. The schema is pinned to commit 7c923cf of main."
      },
      "declaration": {
        "zarrConventions": {
          "uuid": "d0a980b5-c644-4dcc-85a1-283799a58f40"
