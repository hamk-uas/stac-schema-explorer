      "checked": {
        "date": "2026-10-30",
        "source": "https://zarr-specs.readthedocs.io/en/latest/v2/v2.0.html",
        "note": "Zarr format 2 is superseded by format 3 and no longer changes."
      },
      "description": "Chunked n-dimensional arrays in groups; each node has `.zgroup` or `.zarray` and `.zattrs` documents, often consolidated into `.zmetadata`.",
      "mediaTypes": [
        "application/vnd.zarr; version=2",
        "application/vnd.zarr",
        "application/vnd+zarr"
