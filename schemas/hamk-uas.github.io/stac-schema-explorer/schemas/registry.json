    {
      "id": "zarr-v3",
      "title": "Zarr v3",
      "schema": "https://hamk-uas.github.io/stac-schema-explorer/schemas/zarr/v3/schema.json",
      "specification": "https://zarr-specs.readthedocs.io/en/latest/v3/core/index.html",
      "checked": {
        "date": "2026-10-30",
        "latest": "v3.1.0",
        "source": "https://github.com/zarr-developers/zarr-specs/tags",
        "note": "Latest release of the Zarr specifications; the node metadata of format 3 is described by its core specification."
      },
      "description": "Chunked n-dimensional arrays in groups; each node has a `zarr.json` metadata document.",
      "mediaTypes": [
        "application/vnd.zarr; version=3",
        "application/vnd.zarr",
        "application/vnd+zarr"
      ],
      "nodeTypes": [
        "group",
        "array"
