{
  "name": "stac-schema-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A web app for understanding SpatioTemporal Asset Catalog (STAC) core spec and STAC extensions",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "explore": "tsx test/explore.ts"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ajv-formats-draft2019": "^1.6.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  }
}
